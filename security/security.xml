<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_woo_connection_company" model="ir.rule">
        <field name="name">Woo Connection: multi-company</field>
        <field name="model_id" ref="model_space_woo_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_woo_stock_queue_company" model="ir.rule">
        <field name="name">Woo Stock Queue: multi-company</field>
        <field name="model_id" ref="model_space_woo_stock_queue"/>
        <field name="domain_force">[('connection_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_woo_order_log_company" model="ir.rule">
        <field name="name">Woo Order Log: multi-company</field>
        <field name="model_id" ref="model_space_woo_order_log"/>
        <field name="domain_force">[('connection_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
