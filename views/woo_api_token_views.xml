<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_woo_api_token_tree" model="ir.ui.view">
        <field name="name">space.woo.api.token.tree</field>
        <field name="model">space.woo.api.token</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="expiration_date"/>
                <field name="last_used"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_woo_api_token_wizard_form" model="ir.ui.view">
        <field name="name">space.woo.api.token.wizard.form</field>
        <field name="model">space.woo.api.token.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" readonly="raw_token != False"/>
                    <field name="expiration_date" readonly="raw_token != False"/>
                    <field name="raw_token" invisible="not raw_token"
                           widget="CopyClipboardChar"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not raw_token">
                    Copy this token now — it is stored hashed and can never be
                    shown again.
                </div>
                <footer>
                    <button string="Generate Token" type="object"
                            name="action_generate" class="btn-primary"
                            invisible="raw_token != False"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_woo_api_token_wizard" model="ir.actions.act_window">
        <field name="name">Generate API Token</field>
        <field name="res_model">space.woo.api.token.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_woo_api_token" model="ir.actions.act_window">
        <field name="name">API Tokens</field>
        <field name="res_model">space.woo.api.token</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Generate your first API token</p>
            <p>Use the "Generate API Token" action; the token value is shown once.</p>
        </field>
    </record>
</odoo>
