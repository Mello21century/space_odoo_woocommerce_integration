<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_woo_stock_queue_tree" model="ir.ui.view">
        <field name="name">space.woo.stock.queue.tree</field>
        <field name="model">space.woo.stock.queue</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="create_date"/>
                <field name="connection_id"/>
                <field name="product_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'pending'"/>
                <field name="retry_count"/>
                <field name="error_message"/>
                <button name="action_requeue" type="object" string="Requeue"
                        icon="fa-refresh" invisible="state != 'error'"/>
            </tree>
        </field>
    </record>

    <record id="action_woo_stock_queue" model="ir.actions.act_window">
        <field name="name">Stock Push Queue</field>
        <field name="res_model">space.woo.stock.queue</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_filter_not_done': 1}</field>
    </record>

    <record id="view_woo_stock_queue_search" model="ir.ui.view">
        <field name="name">space.woo.stock.queue.search</field>
        <field name="model">space.woo.stock.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <filter name="filter_not_done" string="Pending / Error"
                        domain="[('state', '!=', 'done')]"/>
            </search>
        </field>
    </record>
</odoo>
