<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_woo_order_log_tree" model="ir.ui.view">
        <field name="name">space.woo.order.log.tree</field>
        <field name="model">space.woo.order.log</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="create_date"/>
                <field name="connection_id"/>
                <field name="woo_order_id"/>
                <field name="sale_order_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="view_woo_order_log_form" model="ir.ui.view">
        <field name="name">space.woo.order.log.form</field>
        <field name="model">space.woo.order.log</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-primary" invisible="state != 'error'"/>
                </header>
                <sheet>
                    <group>
                        <field name="connection_id"/>
                        <field name="woo_order_id"/>
                        <field name="sale_order_id"/>
                        <field name="state"/>
                        <field name="error_message"/>
                    </group>
                    <notebook>
                        <page string="Raw Payload">
                            <field name="payload" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_woo_order_log_search" model="ir.ui.view">
        <field name="name">space.woo.order.log.search</field>
        <field name="model">space.woo.order.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="woo_order_id"/>
                <filter name="filter_error" string="Errors"
                        domain="[('state', '=', 'error')]"/>
            </search>
        </field>
    </record>

    <record id="action_woo_order_log" model="ir.actions.act_window">
        <field name="name">Inbound Orders</field>
        <field name="res_model">space.woo.order.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
