<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_woo_connection_tree" model="ir.ui.view">
        <field name="name">space.woo.connection.tree</field>
        <field name="model">space.woo.connection</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="store_url"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_woo_connection_form" model="ir.ui.view">
        <field name="name">space.woo.connection.form</field>
        <field name="model">space.woo.connection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Store">
                            <field name="name"/>
                            <field name="store_url" placeholder="https://mystore.com"/>
                            <field name="consumer_key" password="True"/>
                            <field name="consumer_secret" password="True"/>
                            <field name="webhook_secret" password="True"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Odoo Mapping">
                            <field name="company_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="warehouse_id"/>
                            <field name="discount_product_id"/>
                            <field name="shipping_product_id"/>
                            <field name="auto_invoice"/>
                            <field name="payment_journal_id"
                                   invisible="not auto_invoice"
                                   required="auto_invoice"/>
                        </group>
                    </group>
                    <group string="Last Error" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <div class="alert alert-info" role="status">
                        Webhook URL for this store:
                        <code>https://&lt;your-odoo&gt;/woo/webhook/order/</code><field name="id" readonly="1" class="oe_inline"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_woo_connection" model="ir.actions.act_window">
        <field name="name">Store Connections</field>
        <field name="res_model">space.woo.connection</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
